                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stories",
              "host": ["{{baseUrl}}"],
              "path": ["stories"]
            }
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{authToken}}",
                "type": "string"
              }
            ]
          }
        },
        {
          "name": "Get My Stories",
          "event": [
            {
              "listen": "test",
