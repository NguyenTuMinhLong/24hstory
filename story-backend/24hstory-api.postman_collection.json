              "raw": "{{baseUrl}}/stories/:storyId",
              "host": ["{{baseUrl}}"],
              "path": ["stories", ":storyId"]
            }
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{authToken}}",
                "type": "string"
              }
            ]
          }
        },
        {
          "name": "Delete Story",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200, 403, or 404', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 403, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stories/:storyId",
              "host": ["{{baseUrl}}"],
              "path": ["stories", ":storyId"]
            }
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{authToken}}",
                "type": "string"
              }
            ]
          }
        }
      ]
    },
